<template>
  <div class="page">
    <div class="hero">
      <text class="eyebrow">腕上听书</text>
      <text class="greeting">晚上好，听一段故事吧</text>
      <text class="subline">已为你同步最近的收听进度</text>
    </div>

    <div class="sync-card" onclick="onSyncClick">
      <div class="sync-icon"><text>{{ syncIcon }}</text></div>
      <div class="sync-info"><text class="sync-title">{{ syncTitle }}</text><text class="sync-detail">{{ syncDetail }}</text><div class="sync-track"><div class="sync-fill" style="width: {{ syncProgress }}%;"></div></div></div>
      <text class="sync-action">{{ syncAction }}</text>
    </div>

    <div class="continue-card" onclick="onContinueClick">
      <div class="cover cover-main"><text class="cover-mark">山</text></div>
      <div class="continue-info">
        <text class="book-name">云边有个小卖部</text>
        <text class="author">张嘉佳 · 有声书</text>
        <div class="progress-track"><div class="progress-fill"></div></div>
        <text class="progress-text">已听 3时28分 · 第 18 章</text>
      </div>
      <text class="arrow">›</text>
    </div>

    <div class="section-heading">
      <text class="section-title">我的书架</text>
      <text class="count">3 本</text>
    </div>

    <div class="book-row" onclick="onLycheeClick">
      <div class="cover cover-blue"><text class="cover-mark small">海</text></div>
      <div class="book-info">
        <text class="row-title">海底两万里</text>
        <text class="row-meta">儒勒·凡尔纳 · 42 集</text>
        <text class="row-status">未开始</text>
      </div>
      <text class="play-mini">▶</text>
    </div>

    <div class="book-row" onclick="onContinueClick">
      <div class="cover cover-orange"><text class="cover-mark small">城</text></div>
      <div class="book-info">
        <text class="row-title">长安的荔枝</text>
        <text class="row-meta">马伯庸 · 26 集</text>
        <text class="row-status active">已听 62%</text>
      </div>
      <text class="play-mini">▶</text>
    </div>

    <div class="book-row" onclick="onBookClick">
      <div class="cover cover-green"><text class="cover-mark small">月</text></div>
      <div class="book-info">
        <text class="row-title">月亮与六便士</text>
        <text class="row-meta">毛姆 · 31 集</text>
        <text class="row-status">已听 1 集</text>
      </div>
      <text class="play-mini">▶</text>
    </div>
  </div>
</template>

<script>
export default {
  data: {
    syncStep: 0,
    syncTitle: '等待同步',
    syncDetail: '连接手机后即可传输新章节',
    syncAction: '开始',
    syncIcon: '⌁',
    syncProgress: 0
  },
  onContinueClick() {
    global.router.push({ uri: '/pages/DemoDetail' })
  },

  onBookClick() {
    global.router.push({ uri: '/pages/DemoDetail' })
  },
  onLycheeClick() {
    global.player.bookId = 'lychee'
    global.player.chapterId = 'lychee-1'
    global.player.positionMs = 0
    global.player.chapter = 1
    global.player.chapterName = '荔枝使者'
    global.player.progress = 0
    global.player.currentTime = '0:00'
    global.router.push({ uri: '/pages/DemoDetail' })
  },

  onSyncClick() {
    const states = [
      ['传输中', '正在传输：长安的荔枝 · 第 8 章', '42', '···', '⇅'],
      ['同步失败', '蓝牙连接已断开', '42', '重试', '!'],
      ['同步完成', '已成功同步 1 个新章节', '100', '完成', '✓'],
      ['等待同步', '连接手机后即可传输新章节', '0', '开始', '⌁']
    ]
    const state = states[this.syncStep]
    this.syncTitle = state[0]
    this.syncDetail = state[1]
    this.syncProgress = state[2]
    this.syncAction = state[3]
    this.syncIcon = state[4]
    this.syncStep = (this.syncStep + 1) % states.length
  }
}
</script>

