<template>
  <div class="page">
    <div class="topbar"><input class="back" type="button" value="‹" onclick="onBackClick" /><text class="top-title">正在播放</text><text class="more">···</text></div>
    <div class="book-cover"><text class="cover-title">云边有个</text><text class="cover-title">小卖部</text><text class="cover-author">张嘉佳</text></div>
    <div class="book-details"><text class="name">{{ bookTitle }}</text><text class="narrator">{{ bookAuthor }} · 在线文字朗读</text><text class="content-preview">{{ chapterContent }}</text><text class="network">{{ networkType }}</text><text class="prefetch-status">{{ prefetchStatus }}</text></div>
    <div class="chapter"><text class="chapter-label">第 {{ chapter }} 章</text><text class="chapter-name">{{ chapterName }}</text></div>
    <div class="timeline"><div class="line"><div class="played" style="width: {{ progress }}%;"></div><div class="knob"></div></div><div class="times"><text>{{ currentTime }}</text><text>{{ durationText }}</text></div></div>
    <div class="controls"><input class="skip" type="button" value="↶ 15" onclick="onPreviousClick" /><input class="play" type="button" value="{{ playing ? 'Ⅱ' : '▶' }}" onclick="onPlayClick" /><input class="skip" type="button" value="15 ↷" onclick="onNextClick" /></div>
    <text class="error" if="{{ errorText }}">{{ errorText }}</text>
    <div class="volume-row"><text class="volume-label">音量</text><input class="volume-button" type="button" value="−" onclick="onVolumeDownClick" /><div class="volume-track"><div class="volume-fill" style="width: {{ volume }}%;"></div></div><input class="volume-button" type="button" value="+" onclick="onVolumeUpClick" /><text class="volume-value">{{ volume }}%</text></div>
    <div class="bottom"><input class="bottom-button" type="button" value="☷  目录" onclick="onCatalogClick" /><text class="divider">|</text><input class="speed" type="button" value="{{ speed }}×" onclick="onSpeedClick" /><text class="divider">|</text><input class="timer" type="button" value="{{ timerText }}" onclick="onTimerClick" /></div>
  </div>
</template>

<script>
export default {
  data: {
    playing: false,
    progress: 44,
    currentTime: '12:36',
    chapter: 18,
    chapterName: '山中岁月长',
    speed: '1.0',
    timerText: '◷ 定时',
    volume: 60
    ,bookTitle: '云边有个小卖部'
    ,bookAuthor: '张嘉佳'
    ,errorText: ''
    ,audioReady: false
    ,chapterContent: ''
    ,networkType: '检测网络中'
    ,segment: null
    ,chapterDurationMs: 1720000
    ,lastPrefetchAt: 0
    ,prefetchStatus: '等待预缓存'
    ,durationText: '28:40'
  },
  onShow() {
    this.restorePlayback()
    const book = global.library.find((item) => item.id === global.player.bookId)
    const chapter = book && book.chapters.find((item) => item.id === global.player.chapterId)
    if (book) {
      this.bookTitle = book.title
      this.bookAuthor = book.author
    }
    this.chapter = chapter ? chapter.number : global.player.chapter
    this.chapterName = chapter ? chapter.title : global.player.chapterName
    this.chapterContent = chapter ? chapter.content : ''
    this.chapterDurationMs = chapter ? this.parseDuration(chapter.duration) : 1720000
    this.durationText = chapter ? chapter.duration : '28:40'
    this.progress = global.player.progress
    this.currentTime = global.player.currentTime
    this.bindAudioEvents()
    global.probeNetwork((online, type) => {
      this.networkType = online ? '网络可用 · ' + type : '离线，仅播放已缓存语音'
      this.prefetchStatus = online ? '正在探测在线 TTS…' : '仅播放已完成缓存'
    })
    global.findCachedSegment((segment) => {
      this.segment = segment
      this.audioReady = !!segment
      if (segment) {
        global.player.localUri = segment.uri
        this.errorText = ''
      }
    })
    global.prefetchChapter(global.player.bookId, global.player.chapterId, this.chapterContent, global.player.positionMs).then((segments) => {
      this.prefetchStatus = segments.length ? '已生成 ' + segments.length + ' 个语音片段' : (this.audioReady ? '缓存已就绪' : '等待 TTS 凭据或网络')
      global.findCachedSegmentAt(global.player.positionMs, (segment) => {
        if (!segment && segments.length && segments[0]) segment = segments[0]
        if (!segment) return
        this.segment = segment
        global.player.localUri = segment.uri
        this.audioReady = true
        this.errorText = ''
      })
    }).catch(() => {
      this.prefetchStatus = '预缓存失败，保留已有语音'
      this.errorText = this.networkType.indexOf('离线') === 0 ? '暂无已缓存语音' : '在线 TTS 预取失败，请稍后重试'
    })
  },
  onBackClick() { global.router.back() },
  onPlayClick() {
    if (this.playing) {
      try { global.watchAudioPlayer.pause() } catch (error) {}
      return
    }
    if (!this.audioReady || !global.player.localUri) {
      this.errorText = this.networkType.indexOf('离线') === 0 ? '暂无已缓存语音' : '正在生成语音，请稍候'
      global.prefetchChapter(global.player.bookId, global.player.chapterId, this.chapterContent, global.player.positionMs).then((segments) => {
        this.prefetchStatus = segments.length ? '语音已生成，开始播放' : '没有可播放的缓存片段'
        global.findCachedSegmentAt(global.player.positionMs, (segment) => {
          if (!segment && segments.length) segment = segments[0]
          if (!segment) {
          this.errorText = 'TTS 不可用，请检查网络或凭据'
          return
          }
          this.segment = segment
          global.player.localUri = segment.uri
          this.audioReady = true
          this.errorText = ''
          this.startAudio()
        })
      }).catch(() => { this.errorText = '语音生成失败，请稍后重试' })
      return
    }
    this.startAudio()
  },
  startAudio() {
    this.errorText = ''
    try {
      const sameSource = global.watchAudioPlayer.uri === global.player.localUri
      if (!sameSource) {
        const segmentOffsetMs = this.segment ? Math.max(0, global.player.positionMs - global.getSegmentOffsetMs(this.segment)) : 0
        global.watchAudioPlayer.prepare(global.player.localUri, segmentOffsetMs)
      }
      global.watchAudioPlayer.play()
    } catch (error) {
      this.errorText = '音频播放失败，请检查文件格式'
      this.playing = false
    }
  },
  onPreviousClick() { this.skipSeconds(-15) },
  onNextClick() { this.skipSeconds(15) },
  onCatalogClick() {
    global.router.push({ uri: '/pages/Catalog' })
  },
  onSpeedClick() {
    const speeds = ['1.0', '1.25', '1.5', '2.0']
    const index = speeds.indexOf(this.speed)
    this.speed = speeds[(index + 1) % speeds.length]
  },
  onTimerClick() {
    this.timerText = this.timerText === '◷ 定时' ? '◷ 15分' : '◷ 定时'
  },
  onVolumeDownClick() { this.setVolume(this.volume - 10) },
  onVolumeUpClick() { this.setVolume(this.volume + 10) },
  setVolume(value) {
    this.volume = Math.max(0, Math.min(100, value))
    try { global.audioManager.setVolume({ volumeType: 'MEDIA', volume: this.volume / 100 }) } catch (error) {}
  },
  skipSeconds(offset) {
    if (!global.player.localUri) {
      this.errorText = '暂无语音章节，无法调整进度'
      return
    }
    const currentSeconds = Math.round((this.chapterDurationMs / 1000 * this.progress) / 100)
    this.setPosition(((currentSeconds + offset) * 100) / (this.chapterDurationMs / 1000))
  },
  setPosition(progress) {
    this.progress = Math.max(0, Math.min(100, progress))
    const seconds = Math.round((this.chapterDurationMs / 1000 * this.progress) / 100)
    const minutes = Math.floor(seconds / 60)
    const remaining = seconds % 60
    this.currentTime = minutes + ':' + (remaining < 10 ? '0' : '') + remaining
    const targetPositionMs = seconds * 1000
    const wasPlaying = this.playing
    global.findCachedSegmentAt(targetPositionMs, (segment) => {
      if (segment && (!this.segment || segment.id !== this.segment.id)) {
        this.segment = segment
        global.player.localUri = segment.uri
        this.audioReady = true
        try {
          global.watchAudioPlayer.prepare(segment.uri, Math.max(0, targetPositionMs - global.getSegmentOffsetMs(segment)))
          if (wasPlaying) global.watchAudioPlayer.play()
        } catch (error) { this.errorText = '目标位置尚未缓存' }
      } else {
        try {
          const offsetMs = this.segment ? Math.max(0, targetPositionMs - global.getSegmentOffsetMs(this.segment)) : targetPositionMs
          global.watchAudioPlayer.seek(offsetMs)
        } catch (error) {}
      }
    })
    this.savePlayerState()
  },
  updatePositionFromAudio(seconds) {
    const chapterSeconds = (this.segment ? global.getSegmentOffsetMs(this.segment) / 1000 : 0) + seconds
    this.progress = Math.max(0, Math.min(100, (chapterSeconds * 100) / (this.chapterDurationMs / 1000)))
    const wholeSeconds = Math.round(chapterSeconds)
    const minutes = Math.floor(wholeSeconds / 60)
    const remaining = wholeSeconds % 60
    this.currentTime = minutes + ':' + (remaining < 10 ? '0' : '') + remaining
    this.savePlayerState()
  },
  savePlayerState() {
    global.player.positionMs = Math.round(this.chapterDurationMs * this.progress / 100)
    global.player.chapter = this.chapter
    global.player.chapterName = this.chapterName
    global.player.progress = this.progress
    global.player.currentTime = this.currentTime
  },
  restorePlayback() {
    try {
      const saved = global.storage.getSync({ key: 'playback-state' })
      if (saved) {
        const state = typeof saved === 'string' ? JSON.parse(saved) : saved
        if (state.bookId === global.player.bookId && state.chapterId === global.player.chapterId) {
          global.player.positionMs = state.positionMs || 0
          global.player.progress = state.progress || 0
          global.player.currentTime = state.currentTime || '0:00'
        }
      }
    } catch (error) {}
  },
  persistPlayback() {
    try {
      global.storage.set({
        key: 'playback-state',
        value: JSON.stringify({
          bookId: global.player.bookId,
          chapterId: global.player.chapterId,
          positionMs: Math.round(this.chapterDurationMs * this.progress / 100),
          progress: this.progress,
          currentTime: this.currentTime
        })
      })
    } catch (error) {}
  },
  bindAudioEvents() {
    global.watchAudioPlayer.bind({
      play: () => { this.playing = true },
      pause: () => { this.playing = false; this.persistPlayback() },
      stop: () => { this.playing = false; this.persistPlayback() },
      ended: () => { this.onSegmentEnded() },
      error: () => { this.playing = false; this.errorText = '语音缓存播放失败，请重新生成' },
      timeUpdate: () => {
        const seconds = Number(global.watchAudioPlayer.api.currentTime) || 0
        this.updatePositionFromAudio(seconds)
        this.persistPlayback()
        this.requestPrefetch()
      }
    })
  },
  onSegmentEnded() {
    global.findNextCachedAudio(this.segment && this.segment.uri, (next) => {
      if (!next) {
        this.playing = false
        this.progress = 100
        this.persistPlayback()
        return
      }
      this.segment = next
      global.player.localUri = next.uri
      if (next.chapterId !== global.player.chapterId) this.switchChapter(next.chapterId)
      this.audioReady = true
      this.startAudio()
    })
  },
  parseDuration(value) {
    const parts = String(value || '').split(':').map((item) => Number(item) || 0)
    return (parts.length === 2 ? parts[0] * 60 + parts[1] : 1720) * 1000
  },
  segmentDurationMs() {
    return (global.prefetchManager && global.prefetchManager.config.segmentTargetMs) || 300000
  },
  switchChapter(chapterId) {
    const book = global.library.find((item) => item.id === global.player.bookId)
    const chapter = book && book.chapters.find((item) => item.id === chapterId)
    if (!chapter) return
    global.player.chapterId = chapter.id
    this.chapter = chapter.number
    this.chapterName = chapter.title
    this.chapterContent = chapter.content || ''
    this.chapterDurationMs = this.parseDuration(chapter.duration)
    this.durationText = chapter.duration
    this.progress = 0
    this.currentTime = '0:00'
    this.savePlayerState()
  },
  requestPrefetch() {
    if (!this.chapterContent) return
    const now = Date.now()
    if (now - this.lastPrefetchAt < 15000) return
    this.lastPrefetchAt = now
    global.prefetchChapter(global.player.bookId, global.player.chapterId, this.chapterContent, global.player.positionMs).catch(() => {})
  }
}
</script>

<style lang="scss">
@import './../../assets/styles/style.scss';
.page { flex-direction: column; padding: 5 * $size-factor; background-color: #f7f5ef; }
.topbar { height: 9 * $size-factor; align-items: center; justify-content: space-between; }.back { color: #5a5148; font-size: 8 * $size-factor; background-color: transparent; }.top-title { color: #5e554b; font-size: 3 * $size-factor; }.more { color: #5e554b; font-size: 5 * $size-factor; }
.book-cover { width: 38 * $size-factor; height: 48 * $size-factor; flex-direction: column; justify-content: center; align-items: center; align-self: center; background-color: #c97d47; border-radius: 3 * $size-factor; margin-top: 4 * $size-factor; box-shadow: 0 4 * $size-factor 10 * $size-factor #d6cdc2; }.cover-title { color: #fff8eb; font-size: 7 * $size-factor; font-weight: 600; }.cover-author { color: #f6ddc6; font-size: 3 * $size-factor; margin-top: 4 * $size-factor; }
.book-details { flex-direction: column; align-items: center; margin-top: 5 * $size-factor; }.name { color: #322b25; font-size: 5 * $size-factor; font-weight: 600; }.narrator { color: #988d80; font-size: 3 * $size-factor; margin-top: 1 * $size-factor; }
.chapter { flex-direction: column; align-items: center; margin-top: 6 * $size-factor; }.chapter-label { color: #aa714c; font-size: 3 * $size-factor; }.chapter-name { color: #51483f; font-size: 3.5 * $size-factor; margin-top: 1 * $size-factor; }
.timeline { flex-direction: column; margin-top: 4 * $size-factor; }.line { width: 100%; height: 1 * $size-factor; background-color: #dfd8ce; align-items: center; }.played { width: 44%; height: 100%; background-color: #bd7040; }.knob { width: 2.5 * $size-factor; height: 2.5 * $size-factor; background-color: #bd7040; border-radius: 2 * $size-factor; margin-left: -1 * $size-factor; }.times { justify-content: space-between; margin-top: 1 * $size-factor; }.times text { color: #a89f95; font-size: 2.5 * $size-factor; }
.controls { align-items: center; justify-content: center; margin-top: 5 * $size-factor; }.skip { width: 15 * $size-factor; color: #685e54; font-size: 3 * $size-factor; background-color: transparent; }.play { width: 14 * $size-factor; height: 14 * $size-factor; color: #fffaf2; font-size: 6 * $size-factor; background-color: #bd7040; border-radius: 8 * $size-factor; margin: 0 7 * $size-factor; }
.volume-row { height: 7 * $size-factor; align-items: center; margin-top: 3 * $size-factor; }.volume-label { color: #81766b; font-size: 2.7 * $size-factor; }.volume-button { width: 6 * $size-factor; color: #776d62; font-size: 4 * $size-factor; background-color: transparent; text-align: center; }.volume-track { flex: 1; height: 1 * $size-factor; background-color: #dfd8ce; border-radius: 1 * $size-factor; }.volume-fill { height: 100%; background-color: #bd7040; border-radius: 1 * $size-factor; }.volume-value { width: 9 * $size-factor; color: #a0978d; font-size: 2.5 * $size-factor; text-align: right; }
.content-preview { width: 100%; color: #81766b; font-size: 2.5 * $size-factor; text-align: center; margin-top: 3 * $size-factor; lines: 2; }.network { color: #b06d39; font-size: 2.3 * $size-factor; margin-top: 1 * $size-factor; }.prefetch-status { color: #aa8a65; font-size: 2.2 * $size-factor; margin-top: 1 * $size-factor; }.error { color: #bb4d3d; font-size: 2.5 * $size-factor; text-align: center; margin-top: 2 * $size-factor; }
.bottom { align-items: center; justify-content: center; margin-top: 3 * $size-factor; }.bottom-button, .speed, .timer { color: #776d62; font-size: 3 * $size-factor; background-color: transparent; }.divider { color: #d1c9bf; margin: 0 3 * $size-factor; }
</style>
