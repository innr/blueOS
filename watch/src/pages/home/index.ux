  color: #8B949E;
  font-size: 18px;
  margin-top: 8px;
}

.book-card {
  flex-direction: column;
  padding: 22px;
  margin-top: 24px;
  background-color: #161B22;
  border-radius: 20px;
}

.book-title {
  color: #58A6FF;
  font-size: 26px;
  font-weight: bold;
}

.chapter-title, .status, .progress {
  color: #F0F6FC;
  font-size: 20px;
  margin-top: 10px;
}

.progress {
  color: #8B949E;
}

.primary, .transfer {
  height: 64px;
  margin-top: 18px;
  color: #FFFFFF;
  background-color: #238636;
  border-radius: 14px;
  font-size: 22px;
}

.actions {
  flex-direction: row;
  justify-content: space-between;
  margin-top: 16px;
}

.secondary {
  width: 190px;
  height: 58px;
  color: #F0F6FC;
